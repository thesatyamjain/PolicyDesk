<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PolicyDesk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Benchmark Splash Screen theme (Light Mode) -->
    <style name="Theme.PolicyDesk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F2F2F7</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PolicyDesk</item>
    </style>
</resources>
